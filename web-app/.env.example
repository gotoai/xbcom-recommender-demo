# Copy to web-app/.env and adjust as needed. All optional — sensible defaults apply.

# Bind address for this app.
WEB_HOST=0.0.0.0
WEB_PORT=8091

# UI language.
UI_LANGUAGE=ja

# Stable shuffle seed for the active-user list (fixed so pages/reloads are stable).
USER_SHUFFLE_SEED=20260715

# Users shown per page in the active-user list.
PAGE_SIZE=20

# Override only if the repo layout differs from the default (web-app/ sibling of DATA/).
# The primary TSVs (inbound_traveler / visit / coupon / shop / product) live here.
# DATA_DIR=/abs/path/to/DATA/s03_primary
